# Line endings belong to the repository, not to the machine.
# Without this file, the git setting core.autocrlf of a machine decides the bytes on disk. A
# changed line ending breaks a shell line such as `#!/bin/bash\r` and each recorded SHA-256 of a
# checked-in file: the frozen-file gate (tools/frozen.lock.json) and the Dusk lock check
# (src/styles/dusk.lock.json) hash the bytes on disk.
# Rule: when a program other than git reads the bytes of a file, give its type a line here.
# The first rule below covers each file. A later line changes it for one type.

* text=auto eol=lf

# Must stay LF - a shell reads these bytes.
*.sh      text eol=lf
*.bash    text eol=lf

# Must stay CRLF - cmd.exe and PowerShell read these bytes.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.psm1    text eol=crlf

# Binary - never touch.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.zip     binary
*.gz      binary
*.exe     binary
*.dll     binary
*.pdf     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.wav     binary
*.ogg     binary
*.mp3     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary

# No file of this repository has the type below (checked 2026-11-21).
*.pck     binary

# No line names the types .import, .uid, .tres or .tscn, so the first rule gives them LF.
# No file of this repository has one of these types (checked 2026-11-21).
