{
  "name": "clear-board-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "node tools/check.mjs",
    "check:frozen": "node tools/frozen-check.mjs",
    "check:dusk": "node tools/dusk-lock-check.mjs --copy src/styles/dusk --expect 0.2.0 --app src",
    "check:colour": "node tools/colour-lint.mjs src index.html vite.config.ts public --tokens src/styles/dusk --tokens src/styles/clear-board.tokens.css --exclude src/core/signal.ts --exclude src/stations/yard/geometry.js --exclude src/stations/yard/model.js --exclude src/stations/yard/solver.js --exclude src/stations/yard/puzzles.js --exclude public/data --baseline tools/token-lint.baseline.json",
    "check:names": "node tools/name-check.mjs",
    "typecheck": "tsc -b",
    "test:unit": "node --import ./tests/ts-resolve.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "engines": {
    "node": ">=22.18 <23"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "playwright": "1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
